# Public site URL: leave blank for local development (search indexing is disabled).
NEXT_PUBLIC_SITE_URL=
# Set verified business contact details to enable inquiry email links.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE="+91 8660475439"
# Optional database tools. The public catalogue does not require a database.
DATABASE_URL="file:./prisma/dev.db"
# Required only when running the optional seed. Use a unique 16+ character password.
ADMIN_EMAIL=
ADMIN_PASSWORD=
